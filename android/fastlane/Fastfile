require_relative "validate_changelogs"

default_platform(:android)

PACKAGE_NAME = "com.mateusnavarro77.metronome"
REPO_ROOT = File.expand_path("../..", __dir__)
METADATA_DIR = File.expand_path("metadata/android", __dir__)

platform :android do
  desc "Query Google Play tracks and return the next available versionCode"
  private_lane :next_version_code do
    tracks = %w[production beta alpha internal]
    codes = tracks.flat_map do |track|
      begin
        google_play_track_version_codes(
          package_name: PACKAGE_NAME,
          track: track
        )
      rescue StandardError => e
        UI.message("Skipping track '#{track}' when reading version codes: #{e.message}")
        []
      end
    end

    next_code = (codes.max || 1000) + 1
    UI.important("Next versionCode resolved from Play Store: #{next_code}")
    next_code
  end

  desc "Validate Play Store default.txt changelogs for all locales"
  private_lane :validate_changelogs do
    locales = ChangelogValidator.validate!(METADATA_DIR)
    UI.success("Validated Play Store default.txt changelogs for locales: #{locales.join(', ')}")
  rescue StandardError => e
    UI.user_error!(e.message)
  end

  desc "Generate Play Store phone screenshots using Flutter golden tests"
  lane :screenshots do |options|
    Dir.chdir(REPO_ROOT) do
      sh("flutter", "test", "--tags", "screenshots", "--update-goldens", "test/screenshots/play_store_screenshots_test.dart")
    end

    if options[:upload].to_s == "true"
      upload_to_play_store(
        package_name: PACKAGE_NAME,
        track: "internal",
        metadata_path: METADATA_DIR,
        skip_upload_aab: true,
        skip_upload_apk: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: false
      )
    end
  end

  desc "Build prod AAB with auto-incremented versionCode and upload to Play Store internal track"
  lane :internal do
    validate_changelogs
    version_code = next_version_code

    Dir.chdir(REPO_ROOT) do
      sh(
        "flutter", "build", "appbundle",
        "--release",
        "--flavor", "prod",
        "--build-number", version_code.to_s
      )
    end

    aab_path = Dir[File.join(REPO_ROOT, "build/app/outputs/bundle/prodRelease/*.aab")].first
    UI.user_error!("Could not find release AAB in build/app/outputs/bundle/prodRelease/") unless aab_path

    upload_to_play_store(
      package_name: PACKAGE_NAME,
      track: "internal",
      aab: aab_path,
      metadata_path: METADATA_DIR,
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote latest internal release to beta track without rebuilding"
  lane :promote_to_beta do
    upload_to_play_store(
      package_name: PACKAGE_NAME,
      track: "internal",
      track_promote_to: "beta",
      metadata_path: METADATA_DIR,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote latest beta release to production track with staged rollout"
  lane :promote_to_prod do |options|
    rollout = (options[:rollout] || "0.2").to_s
    upload_to_play_store(
      package_name: PACKAGE_NAME,
      track: "beta",
      track_promote_to: "production",
      rollout: rollout,
      metadata_path: METADATA_DIR,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

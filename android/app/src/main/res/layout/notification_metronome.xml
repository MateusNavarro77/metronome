<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_bpm_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="120"
            android:textColor="@color/metronome_notif_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_bpm_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingBottom="3dp"
            android:text="BPM"
            android:textColor="@color/metronome_notif_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/notif_btn_minus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_notif_stepper"
            android:contentDescription="-1 BPM"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notification_minus" />

        <ImageButton
            android:id="@+id/notif_btn_plus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_notif_stepper"
            android:contentDescription="+1 BPM"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notification_plus" />

        <ImageButton
            android:id="@+id/notif_btn_play_pause"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_notif_play_pause"
            android:contentDescription="Play / Pause"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notification_pause" />

        <ImageButton
            android:id="@+id/notif_btn_close"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="Close"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notification_close" />
    </LinearLayout>

</LinearLayout>
